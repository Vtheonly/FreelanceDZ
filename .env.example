# ============================================================
# FreelanceDZ v4 — Environment configuration
#
# Copy to `.env` (never committed — see .gitignore) and adjust.
# Every value below is consumed by config/settings.py; the list is
# complete: nothing reads secrets from anywhere else.
# ============================================================

# --- Application ---------------------------------------------------
APP_NAME=FreelanceDZ Engine
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json
API_HOST=127.0.0.1            # container deployment overrides to 0.0.0.0
API_PORT=8080

# --- Storage (host paths; containers use /app/data) ---------------
DATABASE_PATH=./data/leads.db
EXPORT_DIR=./data/exports
ATTACHMENTS_DIR=./data/attachments

# --- Discovery ------------------------------------------------------
SCRAPER_TIMEOUT_SECONDS=20
MAX_CONCURRENT_REQUESTS=8
RATE_LIMIT_DELAY_SECONDS=1.5
MAX_SEARCH_PAGES=3
ENABLE_OVERPASS_SCRAPER=true
ENABLE_DDG_SCRAPER=true
DEFAULT_QUERY_LIMIT=30
# v4: dialect variants per campaign (primary + best counterpart)
DISCOVERY_MAX_VARIANTS=2
# Optional local SearXNG metasearch — leave empty to disable.
# Docker: SEARXNG_URL=http://searxng:8080 + `docker compose --profile searxng up`
SEARXNG_URL=

# --- Crawler ----------------------------------------------------------
MAX_CRAWL_DEPTH=3
CRAWLER_WORKERS=8
JITTER_BASE_DELAY=1.0
BLOOM_CAPACITY=2000000

# --- Proxies / resilience (optional) ----------------------------------
# Comma-separated proxy URLs; empty = direct connections.
PROXY_LIST=

# --- Entity resolution --------------------------------------------------
ENTITY_AUTO_RESOLVE=true
ENTITY_RESOLUTION_BATCH=20000

# --- Streamlit UI (ui service only) ---------------------------------
ENGINE_URL=http://localhost:8080
